# -----------------------------------------------------------------------------
# Optional integration-test configuration (LOCAL ONLY — never commit real values)
# -----------------------------------------------------------------------------
# Copy the values you need into your shell before running:
#
#   set -a; source .env.testing; set +a
#   composer test:integration
#
# If any of the required variables below are missing, the integration test
# marks itself skipped (it never fails for an unconfigured developer).
#
# Use a DEDICATED, LOW-PRIVILEGE, throwaway MySQL user for TUNNEL_TEST_DB_* —
# do NOT reuse a real application database user.
# -----------------------------------------------------------------------------

# Path to a passphrase-less (or already ssh-agent-loaded) test SSH key.
TUNNEL_TEST_SSH_KEY_PATH=/home/you/.ssh/id_ed25519_test

# SSH connection details.
TUNNEL_TEST_SSH_USER=someuser
TUNNEL_TEST_SERVER=remote.server.com
TUNNEL_TEST_REMOTE_PORT=3306

# Optional SSH extras (defaults shown).
# TUNNEL_TEST_SSH_PORT=22
# TUNNEL_TEST_SSH_BINARY=/usr/bin/ssh

# Low-privilege, dedicated test MySQL credentials.
TUNNEL_TEST_DB_USER=tunnel_test
TUNNEL_TEST_DB_PASSWORD=change-me
TUNNEL_TEST_DB_NAME=tunnel_test_db
