{
    "name": "404-humannotfound/php-mysql-over-ssh-tunnel",
    "description": "Framework-agnostic PHP library that transparently establishes (or reuses) an SSH local-port-forward tunnel to a remote MySQL server and exposes the local port as a global constant.",
    "type": "library",
    "keywords": ["mysql", "ssh", "tunnel", "port-forward", "codeigniter", "laravel", "pdo"],
    "homepage": "https://github.com/404-HumanNotFound/php-mysql-over-ssh-tunnel",
    "license": "MIT",
    "authors": [
        {
            "name": "404-HumanNotFound",
            "homepage": "https://github.com/404-HumanNotFound"
        }
    ],
    "support": {
        "issues": "https://github.com/404-HumanNotFound/php-mysql-over-ssh-tunnel/issues",
        "source": "https://github.com/404-HumanNotFound/php-mysql-over-ssh-tunnel"
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "ext-posix": "Enables reliable PID-liveness checks (posix_kill($pid, 0)). Without it the library falls back to /proc on Linux or treats liveness as unknown and reconnects."
    },
    "autoload": {
        "psr-4": {
            "HumanNotFound\\MysqlSshTunnel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HumanNotFound\\MysqlSshTunnel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:integration": "phpunit --group integration"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
