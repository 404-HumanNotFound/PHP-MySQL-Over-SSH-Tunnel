<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         defaultTestSuite="unit"
         failOnRisky="true"
         failOnWarning="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <!-- Default suite: pure unit tests, no external dependencies. -->
        <testsuite name="unit">
            <directory>tests</directory>
            <exclude>tests/TunnelIntegrationTest.php</exclude>
        </testsuite>
        <!-- Opt-in suite: real ssh + MySQL, driven by TUNNEL_TEST_* env
             vars; run via `composer test:integration`. -->
        <testsuite name="integration">
            <file>tests/TunnelIntegrationTest.php</file>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>integration</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
