# Configuration for the OPTIONAL real-world integration test suite
# (`composer test:integration`). Copy to a file you do NOT commit (or export
# these in your shell) and fill in values for a server you are authorized to
# tunnel to. Never commit real hosts, key paths, or credentials.
#
#   set -a; source .env.testing; set +a; composer test:integration

# Path to a passphrase-less (or ssh-agent-loaded) SSH key for the test server.
# Do NOT reuse a production key. The library never reads this file's contents;
# the path is handed to the ssh binary via -i.
TUNNEL_TEST_SSH_KEY_PATH=/home/you/.ssh/id_ed25519_tunnel_test

# SSH endpoint.
TUNNEL_TEST_SSH_USER=someuser
TUNNEL_TEST_SERVER=remote.server.com
TUNNEL_TEST_REMOTE_PORT=3306

# Dedicated, LOW-PRIVILEGE MySQL user for testing only — create one with
# nothing more than SELECT on a scratch database. Do not reuse a real
# application DB user.
TUNNEL_TEST_DB_USER=tunnel_test
TUNNEL_TEST_DB_PASSWORD=change-me
TUNNEL_TEST_DB_NAME=tunnel_test_db
