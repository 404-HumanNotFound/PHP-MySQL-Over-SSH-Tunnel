# Copy to .env.testing (do not commit real values) and source before
# running: composer test:integration
# or: php SMOKE_TEST.php

TUNNEL_TEST_SERVER=remote.server.com
TUNNEL_TEST_SSH_PORT=22
TUNNEL_TEST_SSH_USER=someuser
TUNNEL_TEST_SSH_KEY_PATH=/home/user/.ssh/id_ed25519
TUNNEL_TEST_SSH_BINARY_PATH=/usr/bin/ssh
TUNNEL_TEST_REMOTE_PORT=3306
TUNNEL_TEST_LOCAL_PORT=random
TUNNEL_TEST_DB_USER=tunnel_test_user
TUNNEL_TEST_DB_PASSWORD=change-me
TUNNEL_TEST_DB_NAME=tunnel_test
