{
  "name": "404-humannotfound/php-mysql-over-ssh-tunnel",
  "description": "Establish or reuse an SSH local-port-forward tunnel to a remote MySQL server and expose the local port to PHP.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "404-HumanNotFound"
    }
  ],
  "homepage": "https://github.com/404-HumanNotFound/php-mysql-over-ssh-tunnel",
  "support": {
    "issues": "https://github.com/404-HumanNotFound/php-mysql-over-ssh-tunnel/issues",
    "source": "https://github.com/404-HumanNotFound/php-mysql-over-ssh-tunnel"
  },
  "require": {
    "php": ">=8.2",
    "psr/log": "^1.1"
  },
  "suggest": {
    "ext-posix": "For reliable PID liveness checks (optional)."
  },
  "autoload": {
    "psr-4": {
      "PhpMySqlOverSshTunnel\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "type": "library"
}
